<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================================
        Fluent 基线覆盖层（必须排在 XamlControlsResources 之后合并）
        ============================================================================
        为什么单独一个文件：把 Fluent 的同名键放在 App.xaml 自己的 ThemeDictionaries 里
        实测无效 —— 框架的 XamlControlsResources 会抢先命中它自带的主题字典，
        结果是输入框焦点下划线、ProgressRing、选中态仍然渲染成系统强调色而不是我们的值。
        放进「排在 XamlControlsResources 之后」的合并字典，查找顺序才轮到我们。

        这一层只做一件事：把中性灰阶收进暗房的炭灰阶梯。
        **强调色一律不碰** —— 它属于用户的 Windows 个性化设置，
        由框架的 SystemAccentColor* 提供，运行中由 WindowsColorScheme 服务实时跟随。
        ============================================================================
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ==================== Dark（默认） ==================== -->
        <ResourceDictionary x:Key="Dark">

            <!-- 页面底色：不过这个键，Frame 里的 Page 会用框架默认灰阶，
                 在标题栏与内容之间留下一道可见的接缝。 -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF0D0E11" />

            <!-- 表面色阶：房间 → 相纸 → 抬升 → 下沉 -->
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF0D0E11" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF1E2127" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF" />

            <!-- 控件填充与描边（默认按钮 / 下拉 / 输入框的地基） -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF20242B" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />

            <!-- 默认按钮 -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF20242B" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF14161A" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#26FFFFFF" />

            <!-- 文本四级 -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF9AA0AB" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6B7179" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF474C55" />
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF15161A" />

            <!-- 输入框（焦点态留给框架的强调色） -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FF07080A" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF07080A" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF07080A" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6B7179" />

            <!-- 下拉 -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF20242B" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF14161A" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFEDEEF1" />

            <!-- 浮层 / 提示 / 对话框 -->
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF14161A" />
            <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FF1B1E24" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF14161A" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#FFEDEEF1" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF0D0E11" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#9907080A" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF14161A" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#14FFFFFF" />

            <!-- 滚动条：退到几乎不可见，只在需要时浮现 -->
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
        </ResourceDictionary>

        <!-- ==================== Light ==================== -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF7F7F9" />

            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFFBFBFD" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFFBFBFD" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#12000000" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FFE4E4E8" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#12000000" />

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFF0F0F3" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FFF0F0F3" />
            <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#21000000" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#12000000" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFF0F0F3" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF15161A" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#21000000" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF15161A" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF5A606A" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF878D96" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FFB3B7BE" />
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFEDEEF1" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#FFEBEBEF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFEBEBEF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#21000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33000000" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF15161A" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF15161A" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF15161A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF878D96" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#21000000" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF15161A" />

            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#21000000" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#21000000" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FF15161A" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#FF15161A" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#21000000" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0A000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#14000000" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#12000000" />

            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#33000000" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#59000000" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#73000000" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
