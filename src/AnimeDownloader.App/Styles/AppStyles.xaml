<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================================
        暗房 (Darkroom) — 设计令牌
        ============================================================================
        概念：中性冷调炭灰是「房间」，图片是唯一的光源，强调色是暗房里的安全灯 ——
        全应用唯一的彩色，只出现在三种语义上：
            正在被选中 / 正在进行 / 需要你注意

        强调色从哪来：不是这里定的，也不是设计师挑的，而是用户自己的
        Windows 个性化强调色（AppAccent* → SystemAccentColor*，见 App.xaml）。
        所以这一份令牌里看不到任何硬编码的品牌色 —— 换主题、换强调色，
        界面应当整体跟着走，而不是留下几处「设计师的琥珀」。
        三条铁律：
            1. 不用阴影表达层级，只用「表面色阶 + 1px 极细线」。
            2. 数字、页码、分辨率、版本、快捷键一律等宽 (Cascadia Mono)。
            3. 卡片默认无描边无背景差，靠间距成组；只有需要托住内容时才上「相纸」。
        ============================================================================
    -->

    <!-- ==================== 字族 ==================== -->
    <!-- Display：标题与展板文字，收紧字距 -->
    <FontFamily x:Key="AppFontDisplay">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <!-- Text：正文与控件，Win11 文本光学尺寸 -->
    <FontFamily x:Key="AppFontText">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <!-- Mono：所有数字与元数据 —— 本设计的签名细节 -->
    <FontFamily x:Key="AppFontMono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- ==================== 尺度令牌 ==================== -->
    <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <Thickness x:Key="PagePadding">28,22,28,0</Thickness>
    <Thickness x:Key="AppContentPadding">28,20,28,18</Thickness>
    <Thickness x:Key="AppRailPadding">0,10,0,10</Thickness>
    <x:Double x:Key="AppControlFontSize">12.5</x:Double>
    <x:Double x:Key="AppRailWidth">56</x:Double>
    <x:Double x:Key="AppCommandBarHeight">50</x:Double>

    <!-- ==================== 文本样式 ==================== -->
    <!-- 展板大标题：画廊首屏 -->
    <Style x:Key="AppDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontDisplay}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 页面标题（查看器 / 设置） -->
    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontDisplay}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-18" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 眉标：标题上方那行小字，等宽 + 宽字距，编辑部气质 -->
    <Style x:Key="AppEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 说明 / 副标题 -->
    <Style x:Key="AppHintTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 正文 -->
    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 元数据 / 页脚 / 状态：等宽。本设计最容易被记住的一处细节 -->
    <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 等宽强调（页码、计数、缩放百分比） -->
    <Style x:Key="AppMonoStrongStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 表单字段标签 -->
    <Style x:Key="AppLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== 表面 ==================== -->
    <!-- 相纸：托住内容的最小单位。默认无描边，只用表面色阶 -->
    <Style x:Key="AppCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppPanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    </Style>

    <!-- 下沉面：输入框、查看器底衬 -->
    <Style x:Key="AppSunkenBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <!--
        页脚轨道：不再是一个「盒子」，而是一条带顶部分隔线的裸轨道。
        这是把状态栏从「卡片堆」拉回「编辑部排版」的关键一步。
    -->
    <Style x:Key="AppStatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 浮动工具栏（查看器 / 大图窗口）：玻璃 + 内描边模拟折射边缘 -->
    <Style x:Key="AppFloatingToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppToolbarFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="6,5" />
    </Style>

    <!-- ==================== 按钮 ==================== -->
    <!--
        主操作：强调色实心。整页最多出现一次 —— 安全灯只为一件事亮起。
        文字色用 AppAccentInkBrush（按强调色亮度取黑或白），焦点环也用 ink：
        环画在实心块上，若同样取强调色就会自己吃掉自己。
    -->
    <Style x:Key="AppAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentInkBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 顶部 1px 高光：让实心块像被灯照到的实体，而不是平面色块 -->
                        <Border x:Name="TopGloss" Height="1" VerticalAlignment="Top"
                                Margin="1,0,1,0" Opacity="0.35" CornerRadius="1"
                                Background="#FFFFFFFF" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                        <Border x:Name="FocusRing" CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="2" Opacity="0"
                                BorderBrush="{ThemeResource AppAccentInkBrush}"
                                IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <!-- 按压反馈用「填充变暗」而不是缩放：
                                             VisualState 的 Setter 无法表达 scale()，那是 CSS 而非 XAML。 -->
                                        <Setter Target="Fill.Opacity" Value="0.86" />
                                        <Setter Target="TopGloss.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.32" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次操作：细线描边，静默 -->
    <Style x:Key="AppPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineStrongBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                        <Border x:Name="FocusRing" CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="2" Opacity="0"
                                BorderBrush="{ThemeResource AppFocusRingBrush}"
                                IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppCardFillHoverBrush}" />
                                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource AppHairlineStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource AppAccentLineBrush}" />
                                        <Setter Target="Fill.Opacity" Value="0.86" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.36" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 兼容别名：旧页面引用的 AccentButtonStyle -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AppAccentButtonStyle}" />

    <!-- 图标按钮：32×32，悬停只加一层极淡的填充，不发光 -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="FocusRing" CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="2" Opacity="0"
                                BorderBrush="{ThemeResource AppFocusRingBrush}"
                                IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="RootBorder.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.32" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 悬浮在图片上的图标按钮：始终是深色玻璃 + 白图标 -->
    <Style x:Key="AppOverlayIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
        <Setter Property="Background" Value="#B30B0C0F" />
        <Setter Property="Foreground" Value="#FFF2F3F5" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="AppSmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ==================== 分段控件 ==================== -->
    <!--
        细线分段器：容器透明 + 1px 极细线；选中项用琥珀底衬，不用实心强调块，
        这样「当前选项」是暖的，但不会在界面里砸出一个洞。
    -->
    <Style x:Key="AppSegmentRadioStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.36" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="{ThemeResource AppAccentLineBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="Transparent" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="Transparent" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- 选中色与悬停反馈分层：CheckBorder 只受 CheckStates 控制，
                             HoverLayer 只受 CommonStates 控制，避免两组状态争抢同一属性。 -->
                        <Border x:Name="CheckBorder" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="5" />
                        <Border x:Name="HoverLayer"
                                Background="{ThemeResource AppSubtleHoverBrush}"
                                CornerRadius="5" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段开关（画廊工具栏的随机 / 自动刷新用）：形状与分段器一致 -->
    <Style x:Key="AppSegmentToggleStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineStrongBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppSubtlePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.36" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="{ThemeResource AppAccentLineBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="CheckBorder.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="UncheckedPointerOver" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="CheckBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 导轨导航项 ==================== -->
    <!--
        56px 导轨里的一个目的地。
        为什么不用 NavigationView：它的收起态会把 PaneCustomContent 一并渲染进 56px 里
        （快捷键表被整段裁切）、把菜单项挤到导轨底部，并且选中指示条走的是框架资源、
        实测不吃应用层的覆盖（渲染成品红）。导航这件事只有三个图标，自己画更可控。
        选中语义：强调色底衬 + 左缘 3×18 圆角指示条 + 图标转强调色。

        两个 Min* 归零不是洁癖，是必须的：RadioButton 的框架默认样式把
        MinWidth 压在 120（RadioButtonMinWidth），而 FrameworkElement 的显式 Width
        会被 MinWidth 夹回去 —— 于是「56 宽」的导航项实际排成 120 宽，
        横向溢出 56px 导轨、糊在内容区上，图标也被推到导轨外面。这个坑很隐蔽：
        模板、列宽、截图缩放看着都对，只有量像素才发现。
    -->
    <Style x:Key="AppRailItemStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!--
            提示气泡必须朝右开。导轨只有 56px 宽、且贴着窗口左缘，而默认的
            ToolTipService.Placement=Top 会把气泡在锚点正上方居中 —— 锚点才 40px 宽，
            气泡却有一百多像素，于是向左溢出窗口、被裁掉开头的字。
            实测（1424x892 帧）：气泡文字从 x=0 起一直排到 x≈186，"设"字只剩右半。
            朝右开之后气泡完全落在内容区里，怎么量都是完整的。
        -->
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppSubtleHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppSubtlePressedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource AppAccentLineBrush}" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource AppAccentLineBrush}" />
                                        <Setter Target="Fill.Opacity" Value="0.86" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="UncheckedPointerOver" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- 底衬内缩 8px：命中区域撑满导轨宽度，但视觉块不贴边 -->
                        <Border x:Name="Fill" Margin="8,3,8,3"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="10" />
                        <Border x:Name="FocusRing" Margin="8,3,8,3" BorderThickness="2" Opacity="0"
                                CornerRadius="10" BorderBrush="{ThemeResource AppFocusRingBrush}"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                        <!-- 选中指示：贴着导轨左缘的一道琥珀细条 -->
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2"
                                Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Opacity="0" Background="{ThemeResource AppAccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 状态 ==================== -->
    <!--
        状态语义只有三档，而不是五颜六色：
        安静（灰，无光源）/ 工作（琥珀，安全灯亮起）/ 故障（红）。
    -->
    <Style x:Key="AppStatusDotBaseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
    </Style>
    <Style x:Key="AppStatusDotOkStyle" TargetType="Ellipse" BasedOn="{StaticResource AppStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource AppStatusIdleBrush}" />
    </Style>
    <Style x:Key="AppStatusDotBusyStyle" TargetType="Ellipse" BasedOn="{StaticResource AppStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource AppAccentBrush}" />
    </Style>
    <Style x:Key="AppStatusDotErrorStyle" TargetType="Ellipse" BasedOn="{StaticResource AppStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource AppStatusErrorBrush}" />
    </Style>

    <!-- ==================== 标签 / 徽章 ==================== -->
    <!-- 描边胶囊标签：编辑部标签的写法，等宽小字 -->
    <Style x:Key="AppChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppTagChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource AppAccentLineBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="Fill.Opacity" Value="0.86" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.36" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 设置页：无卡片化的参数表 ==================== -->
    <!-- 分组眉标 -->
    <Style x:Key="AppGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!--
        「设置卡片」在本设计里不再是一张卡片，而是参数表里的一行：
        透明底 + 底部 1px 极细线。分组靠留白与眉标，不靠盒子。
    -->
    <Style x:Key="AppSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppSettingsRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="20" />
    </Style>

    <Style x:Key="AppSettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSettingsDescStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontText}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== 空状态 ==================== -->
    <Style x:Key="AppEmptyGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextQuaternaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
