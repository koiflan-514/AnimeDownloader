<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 设计令牌 ==================== -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <Thickness x:Key="PagePadding">24,16,24,20</Thickness>
    <x:Double x:Key="AppControlFontSize">13</x:Double>

    <!-- ==================== 文本样式 ==================== -->
    <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <!-- Fluent 字阶：页面标题 = Title 28px -->
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="AppHintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ==================== 表面样式 ==================== -->
    <Style x:Key="AppCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppPanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    </Style>

    <Style x:Key="AppStatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppPanelFillBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 浮动工具栏（查看器 / 大图窗口） -->
    <Style x:Key="AppFloatingToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppToolbarFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ==================== 按钮样式 ==================== -->
    <!-- 强调按钮（主操作）：纯色强调 + 常规字重，与 Win11 原生一致 -->
    <Style x:Key="AppAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppAccentGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 圆角矩形按钮（次要操作） -->
    <Style x:Key="AppPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppTagChipBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 兼容别名：旧页面引用的 AccentButtonStyle -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AppAccentButtonStyle}" />

    <!-- 分段控件选项（RadioButton：原生单选互斥 + 成熟视觉状态机，选中态即时刷新） -->
    <Style x:Key="AppSegmentRadioStyle" TargetType="RadioButton">
        <!-- Stretch：选项拉伸填满 Grid 星号列，保证所有选项等宽 -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                                        <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentGradientBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentGradientBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentGradientBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- 选中强调色与悬停反馈分层：CheckBorder 只受 CheckStates 控制，
                             HoverLayer 只受 CommonStates 控制，避免两组状态争抢同一属性
                             导致选中强调色在指针/焦点掠过时被悬停底色覆盖 -->
                        <Border x:Name="CheckBorder" Background="Transparent" CornerRadius="7" />
                        <Border x:Name="HoverLayer"
                                Background="{ThemeResource AppTagChipBrush}"
                                CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段开关（ToggleButton 版：画廊工具栏的随机/自动刷新开关用） -->
    <Style x:Key="AppSegmentToggleStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                                        <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentGradientBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentGradientBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="{ThemeResource AppAccentGradientBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CheckBorder.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- 选中强调色与悬停反馈分层：CheckBorder 只受 CheckStates 控制，
                             HoverLayer 只受 CommonStates 控制，避免两组状态争抢同一属性
                             导致选中强调色在指针/焦点掠过时被悬停底色覆盖 -->
                        <Border x:Name="CheckBorder" Background="Transparent" CornerRadius="7" />
                        <Border x:Name="HoverLayer"
                                Background="{ThemeResource AppTagChipBrush}"
                                CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 圆角图标按钮（查看器 / 大图窗口浮动栏） -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AppTagChipBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小号图标按钮（卡片悬浮快捷操作） -->
    <Style x:Key="AppSmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 状态点（底部状态胶囊） -->
    <Style x:Key="AppStatusDotBaseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    <Style x:Key="AppStatusDotOkStyle" TargetType="Ellipse" BasedOn="{StaticResource AppStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource AppStatusOkBrush}" />
    </Style>
    <Style x:Key="AppStatusDotBusyStyle" TargetType="Ellipse" BasedOn="{StaticResource AppStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource AppStatusBusyBrush}" />
    </Style>
    <Style x:Key="AppStatusDotErrorStyle" TargetType="Ellipse" BasedOn="{StaticResource AppStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource AppStatusErrorBrush}" />
    </Style>

    <!-- ==================== 其他 ==================== -->
    <!-- 标签块（活动标签 / 信息徽章） -->
    <Style x:Key="AppChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppTagChipBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== Win11 设置行（SettingsCard 风格） ==================== -->
    <!-- 分组标题：BodyStrong 14px，置于每张卡片组上方 -->
    <Style x:Key="AppGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <!-- 设置卡片：系统主题画刷 + 4px 圆角 + 16px 内边距，与 Win11 设置一致 -->
    <Style x:Key="AppSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 设置行：左侧标题 + 描述，右侧控件（行内容自行布置） -->
    <Style x:Key="AppSettingsRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <!-- 设置行标题：Body 14px -->
    <Style x:Key="AppSettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 设置行描述：Caption 12px 次要色 -->
    <Style x:Key="AppSettingsDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>