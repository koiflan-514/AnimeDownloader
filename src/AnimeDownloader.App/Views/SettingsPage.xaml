<Page
    x:Class="AnimeDownloader.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnimeDownloader.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="14"
                    MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
                <TextBlock Text="设置" Style="{StaticResource AppSectionTitleStyle}" />
                <TextBlock Text="调整图源、网络与下载行为，保存后立即生效"
                           Style="{StaticResource AppHintTextStyle}" />
            </StackPanel>

            <!-- ============ 通用 ============ -->
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="18,16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{ThemeResource AppAccentSoftBrush}">
                            <FontIcon Glyph="&#xE713;" FontSize="14"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="通用" Style="{StaticResource AppCardTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="20" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Text="NSFW 过滤" Style="{StaticResource AppCaptionTextStyle}" />
                            <controls:SegmentedControl x:Name="NsfwSegmented" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Text="主题" Style="{StaticResource AppCaptionTextStyle}" />
                            <controls:SegmentedControl x:Name="ThemeSegmented" />
                        </StackPanel>
                        <NumberBox x:Name="IntervalBox" Grid.Row="1" Grid.Column="0"
                                   Header="自动刷新间隔（秒）" Minimum="1" Value="30"
                                   SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="CountBox" Grid.Row="1" Grid.Column="1"
                                   Header="画廊每页数量" Minimum="1" Maximum="48"
                                   Value="12" SpinButtonPlacementMode="Compact" />
                        <CheckBox x:Name="AutoReloadCheck" Grid.Row="2" Grid.Column="0"
                                  Content="启用自动刷新" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 网络与代理 ============ -->
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="18,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{ThemeResource AppAccentSoftBrush}">
                            <FontIcon Glyph="&#xE968;" FontSize="14"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="网络与代理" Style="{StaticResource AppCardTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox x:Name="ProxyBox" Header="手动代理地址（留空则自动检测系统代理）"
                             PlaceholderText="http://127.0.0.1:7890" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="TimeoutBox" Grid.Column="0" Header="请求超时（秒）"
                                   Minimum="5" Maximum="120" Value="20"
                                   SpinButtonPlacementMode="Compact" />
                        <CheckBox x:Name="NoProxyCheck" Grid.Column="1" Content="不使用代理（直连）"
                                  VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 下载 ============ -->
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="18,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{ThemeResource AppAccentSoftBrush}">
                            <FontIcon Glyph="&#xE896;" FontSize="14"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="下载" Style="{StaticResource AppCardTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadDirBox" Grid.Column="0" Header="批量下载目录"
                                 PlaceholderText="选择保存图片的文件夹" />
                        <Button x:Name="BrowseDirButton" Grid.Column="1" Content="浏览…"
                                Style="{StaticResource AppPillButtonStyle}"
                                VerticalAlignment="Bottom" Click="OnBrowseDir" />
                    </Grid>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="ConcurrencyBox" Grid.Column="0"
                                   Header="最大并发下载数" Minimum="1" Maximum="16"
                                   Value="4" SpinButtonPlacementMode="Compact" />
                        <ToggleSwitch x:Name="CacheToggle" Grid.Column="1"
                                      Header="启用缩略图缓存（内存 + 磁盘）"
                                      VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBox x:Name="ProxyTemplateBox">
                        <TextBox.Header>缩略图代理模板（可选，含 {url} 占位）</TextBox.Header>
                        <TextBox.PlaceholderText>https://images.weserv.nl/?url={url}&amp;w=480&amp;h=480&amp;fit=cover&amp;output=jpg</TextBox.PlaceholderText>
                    </TextBox>
                    <Button x:Name="ClearCacheButton" Content="清除缩略图缓存"
                            Style="{StaticResource AppPillButtonStyle}" Click="OnClearCache"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ============ 网络检测 ============ -->
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="18,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{ThemeResource AppAccentSoftBrush}">
                            <FontIcon Glyph="&#xE774;" FontSize="14"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="网络检测（哪些源需要科学上网）"
                                   Style="{StaticResource AppCardTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="分别以“直连”和“当前代理设置”探测各图源端点，判断是否需要代理。"
                               Style="{StaticResource AppHintTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ProbeButton" Content="检测源连通性"
                                Style="{StaticResource AppAccentButtonStyle}"
                                Click="OnProbeConnectivity" />
                        <ProgressRing x:Name="ProbeRing" Width="20" Height="20" IsActive="False"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl x:Name="ProbeResults">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" Grid.Column="0" />
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               Grid.Column="1"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" Grid.Column="2"
                                               Style="{StaticResource AppCaptionTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ 图源标签 ============ -->
            <Border x:Name="TagsCard" Style="{StaticResource AppCardBorderStyle}" Padding="18,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{ThemeResource AppAccentSoftBrush}">
                            <FontIcon Glyph="&#xE1AC;" FontSize="14"
                                      Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="图源标签" Style="{StaticResource AppCardTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="TagsPanel" Spacing="8" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="WarningBar" IsOpen="False" Severity="Warning" IsClosable="True" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton" Content="保存设置"
                        Style="{StaticResource AppAccentButtonStyle}" Click="OnSave" />
                <Button x:Name="ResetButton" Content="恢复默认"
                        Style="{StaticResource AppPillButtonStyle}" Click="OnReset" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource AppCaptionTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
