<Page
    x:Class="AnimeDownloader.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnPageKeyDown"
    IsTabStop="True">

    <!--
        画廊 = 接触印相（Contact Sheet）
        ============================================================================
        旧版把「标题 / 页码 / 标签 / 工具栏」摞成三条并排的功能条，视觉重量全在边缘，
        中间那张网格反而最轻。
        新版按印刷厂的接触印相来处理：
            上方只有「眉标 + 标题 + 一行说明」，一条细线切开，接着是筛选行。
            翻页、批量下载、进度这些「关于这一批」的操作全部下放到页脚轨道。
            中间留给图片，先看画，再谈操作。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            标签联想弹层：复选框多选智能提示（含中文译名 / 热度 / 类别 / 相关标签）

            它的位置有讲究，不是随便挂哪儿都行 ——
            Popup 的 Horizontal/VerticalOffset 是相对「父容器内容原点 + 自身布局槽位」的，
            而槽位原点**已经包含了排在它前面的兄弟元素高度**。
            之前它挂在头部 StackPanel 的末尾，槽位原点已经累积了「眉标 / 标题 / 说明 / 细线 /
            筛选行」的全部高度（实测 172px），代码又把整份相对页面的坐标加了上去 ——
            等于加了两遍，弹层于是掉到搜索框下方约 200px 处、横向也偏右 26px。

            解法：让它成为根 Grid 的第一个子元素。首个子元素的槽位原点就是父容器内容原点，
            于是 offset 的语义被钉死为「页面坐标」，与 TagSearchHost.TransformToVisual(this)
            完全同源，不再有歧义。（Popup 自身 DesiredSize 为 0，落在第 0 行不会撑高行高。）
        -->
        <Popup x:Name="TagSuggestPopup" IsLightDismissEnabled="True">
            <Border Background="{ThemeResource AppCardFillBrush}"
                    BorderBrush="{ThemeResource AppHairlineStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    Width="460" MaxHeight="400" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6" MinWidth="436">
                        <TextBlock x:Name="SuggestHeaderText"
                                   Text="标签联想（勾选加入搜索）"
                                   Style="{StaticResource AppGroupHeaderStyle}" Margin="4,2" />
                        <ItemsControl x:Name="SuggestList" />
                        <TextBlock x:Name="RelatedHeaderText" Text="相关标签"
                                   Style="{StaticResource AppGroupHeaderStyle}" Margin="4,10,4,2"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="RelatedList" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- ============ 头部：眉标 / 标题 / 筛选 ============ -->
        <StackPanel Grid.Row="0" Padding="28,22,28,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="接触印相" Style="{StaticResource AppEyebrowStyle}" />
                    <TextBlock Text="灵感画廊" Style="{StaticResource AppDisplayStyle}" />
                    <TextBlock x:Name="GalleryHint" Style="{StaticResource AppHintTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="620" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{ThemeResource AppHairlineBrush}" Margin="0,18,0,0" />

            <!-- 筛选行：标签搜索 + 两个模式开关（窄窗口横向滚动，不挤压） -->
            <ScrollViewer Margin="0,14,0,16"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                          ZoomMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border x:Name="TagSearchHost"
                            Background="{ThemeResource AppSurfaceSunkenBrush}"
                            BorderBrush="{ThemeResource AppHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="2"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="236" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="12"
                                      Foreground="{ThemeResource AppTextTertiaryBrush}"
                                      VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBox x:Name="TagBox" Grid.Column="1" BorderThickness="0"
                                     Background="Transparent" FontSize="12.5"
                                     PlaceholderText="输入标签搜索（回车应用）"
                                     VerticalAlignment="Center"
                                     KeyDown="OnTagBoxKeyDown"
                                     TextChanged="OnTagBoxTextChanged" />
                            <Button x:Name="TagApplyButton" Grid.Column="2"
                                    Style="{StaticResource AppSmallIconButtonStyle}"
                                    Click="OnTagApply"
                                    ToolTipService.ToolTip="应用标签并刷新">
                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="TagChip"
                            Background="{ThemeResource AppAccentSoftBrush}"
                            BorderBrush="{ThemeResource AppAccentLineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PillCornerRadius}"
                            Padding="9,3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="TagChipText" FontSize="11"
                                       FontFamily="{StaticResource AppFontMono}"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="ClearTagButton" Style="{StaticResource AppSmallIconButtonStyle}"
                                    Width="18" Height="18" Click="OnClearTag"
                                    ToolTipService.ToolTip="清除标签">
                                <FontIcon Glyph="&#xE711;" FontSize="9" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Width="1" Height="18" Background="{ThemeResource AppHairlineStrongBrush}"
                            VerticalAlignment="Center" Margin="4,0" />

                    <ToggleButton x:Name="ModeToggle" Content="随机模式"
                                  Style="{StaticResource AppSegmentToggleStyle}"
                                  Click="OnModeToggleClick"
                                  ToolTipService.ToolTip="每页随机抽取，而不是按顺序翻页" />
                    <ToggleButton x:Name="AutoReloadToggle" Content="自动刷新"
                                  Style="{StaticResource AppSegmentToggleStyle}"
                                  Click="OnAutoReloadClick"
                                  ToolTipService.ToolTip="按设定间隔自动重新加载" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- ============ 印相网格 ============ -->
        <Grid Grid.Row="1" Padding="28,0,28,0">
            <GridView
                x:Name="ThumbGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnThumbClick"
                IsTabStop="True"
                AutomationProperties.Name="图片画廊"
                SizeChanged="OnGridSizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 瓦片尺寸由 UpdateGridLayout 按窗口宽度重算（值 = 卡片 + 10px 间隙）；
                             这里的初值只是首帧的合理默认，避免第一帧出现 180 的旧节奏。 -->
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="248" ItemHeight="248" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <!-- 空状态：不是一句「暂无数据」，而是告诉人下一步做什么 -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="400">
                <Border Width="52" Height="52" CornerRadius="14"
                        Background="{ThemeResource AppSurfaceSunkenBrush}"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE91B;" FontSize="22"
                              Foreground="{ThemeResource AppTextTertiaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="暂无图片"
                           Style="{StaticResource AppCardTitleTextStyle}"
                           FontSize="15" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource AppBodyTextStyle}"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <Button x:Name="EmptyActionButton" Content="换一批看看"
                        Style="{StaticResource AppPillButtonStyle}"
                        HorizontalAlignment="Center" Click="OnRetry"
                        Visibility="Collapsed" />
            </StackPanel>

            <InfoBar x:Name="WelcomeBar"
                     IsOpen="False" IsClosable="True"
                     Severity="Informational"
                     Title="从这里开始"
                     Message="选择图源后点刷新即可浏览；单击卡片选中，双击看大图并保存，页脚可批量下载。"
                     Closed="OnWelcomeBarClosed"
                     VerticalAlignment="Bottom" Margin="0,0,0,10">
                <InfoBar.ActionButton>
                    <Button Content="了解设置" Click="OnOpenSettings" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <!-- ============ 页脚轨道：本批次的进度 + 翻页 + 批量下载 ============ -->
        <Border Grid.Row="2" Style="{StaticResource AppStatusBarStyle}"
                Height="48" Padding="20,0,16,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：这一批的状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6"
                             Style="{StaticResource AppStatusDotOkStyle}"
                             VerticalAlignment="Center" />
                    <ProgressRing x:Name="LoadingRing" Width="15" Height="15"
                                  IsActive="False" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="就绪"
                               Style="{StaticResource AppCaptionTextStyle}"
                               MaxWidth="420" />
                    <ProgressBar x:Name="BatchProgress" Width="132"
                                 Visibility="Collapsed" Minimum="0" Maximum="1" Value="0"
                                 VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右：页序与整批操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="RetryButton" Content="重试"
                            Style="{StaticResource AppPillButtonStyle}"
                            Visibility="Collapsed" Click="OnRetry" />
                    <Button x:Name="CancelBatchButton" Content="取消"
                            Style="{StaticResource AppPillButtonStyle}"
                            Visibility="Collapsed" Click="OnCancelBatch" />
                    <TextBlock x:Name="PageLabel" Text="第 1 页"
                               Style="{StaticResource AppMonoStrongStyle}"
                               Margin="6,0,2,0" />
                    <Button x:Name="PrevPageButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnPrevPage" ToolTipService.ToolTip="上一页（←）">
                        <FontIcon Glyph="&#xE76B;" FontSize="13" />
                    </Button>
                    <Button x:Name="NextPageButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnNextPage" ToolTipService.ToolTip="下一页（→）">
                        <FontIcon Glyph="&#xE76C;" FontSize="13" />
                    </Button>
                    <Button x:Name="DownloadAllButton" MinWidth="112"
                            Style="{StaticResource AppAccentButtonStyle}"
                            Click="OnDownloadAll" ToolTipService.ToolTip="下载当前页全部图片">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                            <TextBlock Text="下载全部" TextTrimming="None" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
