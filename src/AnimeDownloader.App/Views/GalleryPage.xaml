<Page
    x:Class="AnimeDownloader.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnPageKeyDown"
    IsTabStop="True">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部：标题 / 标签搜索 / 工具栏（三行，窄窗口自动换行不重叠） ============ -->
        <Grid Grid.Row="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 第 1 行：标题 + 页码 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="灵感画廊" Style="{StaticResource AppSectionTitleStyle}" />
                    <TextBlock x:Name="GalleryHint" Style="{StaticResource AppHintTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="PageLabel" Grid.Column="1" Text="第 1 页"
                           Style="{StaticResource AppCaptionTextStyle}"
                           VerticalAlignment="Top" Margin="16,8,0,0" />
            </Grid>

            <!-- 第 2 行：标签搜索 + 活动标签胶囊（窄窗口横向滚动不截断） -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                          ZoomMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="TagSearchHost" Style="{StaticResource AppPanelBorderStyle}"
                            Padding="4,3" CornerRadius="10"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="13"
                                      Foreground="{ThemeResource AppTextSecondaryBrush}"
                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="TagBox" Grid.Column="1" BorderThickness="0"
                                     Background="Transparent" FontSize="12.5"
                                     PlaceholderText="输入标签搜索（回车应用）"
                                     VerticalAlignment="Center"
                                     KeyDown="OnTagBoxKeyDown" />
                            <Button x:Name="TagApplyButton" Grid.Column="2"
                                    Style="{StaticResource AppSmallIconButtonStyle}"
                                    Click="OnTagApply"
                                    ToolTipService.ToolTip="应用标签并刷新">
                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border x:Name="TagChip" Style="{StaticResource AppChipBorderStyle}"
                            Background="{ThemeResource AppAccentSoftBrush}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="TagChipText" FontSize="11.5"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="ClearTagButton" Style="{StaticResource AppSmallIconButtonStyle}"
                                    Width="20" Height="20" Click="OnClearTag"
                                    ToolTipService.ToolTip="清除标签">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 第 3 行：工具栏（窄窗口横向滚动，按钮始终完整显示） -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                          ZoomMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="ModeToggle" Content="随机模式"
                                  Style="{StaticResource AppSegmentToggleStyle}"
                                  Click="OnModeToggleClick" />
                    <Button x:Name="PrevPageButton" Style="{StaticResource AppPillButtonStyle}"
                            Click="OnPrevPage" ToolTipService.ToolTip="上一页（←）">
                        <FontIcon Glyph="&#xE76B;" FontSize="13" />
                    </Button>
                    <Button x:Name="NextPageButton" Style="{StaticResource AppPillButtonStyle}"
                            Click="OnNextPage" ToolTipService.ToolTip="下一页（→）">
                        <FontIcon Glyph="&#xE76C;" FontSize="13" />
                    </Button>
                    <Button x:Name="DownloadAllButton" MinWidth="120"
                            Style="{StaticResource AppAccentButtonStyle}"
                            Click="OnDownloadAll" ToolTipService.ToolTip="下载当前页全部图片">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="下载全部" TextTrimming="None" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="AutoReloadToggle" Content="自动刷新"
                                  Style="{StaticResource AppSegmentToggleStyle}"
                                  Click="OnAutoReloadClick" />
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ============ 画廊网格 ============ -->
        <Grid Grid.Row="1">
            <GridView
                x:Name="ThumbGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnThumbClick"
                IsTabStop="True"
                AutomationProperties.Name="图片画廊"
                SizeChanged="OnGridSizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="180" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <!-- 空状态 / 欢迎提示 -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="420">
                <FontIcon Glyph="&#xE91B;" FontSize="40"
                          Foreground="{ThemeResource AppTextSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="暂无图片" Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource AppHintTextStyle}"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <Button x:Name="EmptyActionButton" Content="换一批看看" Style="{StaticResource AppPillButtonStyle}"
                        HorizontalAlignment="Center" Click="OnRetry"
                        Visibility="Collapsed" />
            </StackPanel>

            <InfoBar x:Name="WelcomeBar"
                     IsOpen="False" IsClosable="True"
                     Severity="Informational"
                     Title="从这里开始"
                     Message="选择图源后点击刷新即可浏览；单击卡片选中，双击查看原图并保存，工具栏可批量下载。"
                     Closed="OnWelcomeBarClosed"
                     VerticalAlignment="Bottom" Margin="0,0,0,8">
                <InfoBar.ActionButton>
                    <Button Content="了解设置" Click="OnOpenSettings" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <!-- ============ 底部状态栏 ============ -->
        <Border Grid.Row="2" Style="{StaticResource AppStatusBarStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                         Style="{StaticResource AppStatusDotOkStyle}"
                         VerticalAlignment="Center" />
                <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="16" Height="16"
                              IsActive="False" VerticalAlignment="Center" />
                <ProgressBar x:Name="BatchProgress" Grid.Column="2" Width="160"
                             Visibility="Collapsed" Minimum="0" Maximum="1" Value="0"
                             VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" Grid.Column="3" Text="就绪"
                           Style="{StaticResource AppCaptionTextStyle}" />
                <Button x:Name="CancelBatchButton" Grid.Column="4" Content="取消"
                        Style="{StaticResource AppPillButtonStyle}"
                        Visibility="Collapsed" Click="OnCancelBatch" />
                <Button x:Name="RetryButton" Grid.Column="4" Content="重试"
                        Style="{StaticResource AppPillButtonStyle}"
                        Visibility="Collapsed" Click="OnRetry" />
            </Grid>
        </Border>
    </Grid>
</Page>