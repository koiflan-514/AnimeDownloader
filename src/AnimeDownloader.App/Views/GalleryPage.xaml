<Page
    x:Class="AnimeDownloader.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnimeDownloader.App.Controls">

    <Grid Padding="12,8,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="SourceCombo"
                MinWidth="180"
                Header="图源"
                SelectionChanged="OnSourceChanged" />

            <ComboBox
                x:Name="NsfwCombo"
                MinWidth="140"
                Header="NSFW"
                SelectionChanged="OnNsfwChanged">
                <ComboBoxItem Content="屏蔽 NSFW" Tag="BlockNsfw" />
                <ComboBoxItem Content="仅 NSFW" Tag="OnlyNsfw" />
                <ComboBoxItem Content="全部显示" Tag="ShowEverything" />
            </ComboBox>

            <ToggleButton
                x:Name="ModeToggle"
                Content="随机模式"
                Margin="0,20,0,0"
                Checked="OnModeToggleChecked"
                Unchecked="OnModeToggleUnchecked" />

            <StackPanel x:Name="PageControls" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <Button x:Name="PrevPageButton" Content="上一页" Click="OnPrevPage" />
                <TextBlock x:Name="PageLabel" Text="第 1 页" VerticalAlignment="Center" Margin="4,0" />
                <Button x:Name="NextPageButton" Content="下一页" Click="OnNextPage" />
            </StackPanel>

            <TextBlock x:Name="PagingHint" Text="该图源不支持分页浏览" VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button x:Name="RefreshButton" Content="刷新" Margin="0,20,0,0" Click="OnRefresh" />

            <ToggleSwitch x:Name="AutoReloadSwitch" Header="自动刷新" Margin="8,8,0,0"
                          Toggled="OnAutoReloadToggled" />
        </StackPanel>

        <!-- 缩略图网格 -->
        <GridView
            x:Name="ThumbGrid"
            Grid.Row="1"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnThumbClick"
            Padding="0,4,0,0">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="180" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <controls:ImageCard Width="180" Height="180" Item="{Binding}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False" />
            <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
