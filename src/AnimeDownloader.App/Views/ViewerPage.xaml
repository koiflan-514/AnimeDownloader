<Page
    x:Class="AnimeDownloader.App.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnimeDownloader.App.Controls"
    IsTabStop="True"
    KeyDown="OnPageKeyDown">

    <!--
        灯箱（Light Table）
        ============================================================================
        查看器不该是「一个带工具栏的页面」，而应该是一张被照亮的台面：
        图片占据绝大部分面积，控件全部退化成浮在暗面上的玻璃。
        顶部只留一行眉标与等宽元数据，底部一条页脚轨道 —— 上下的「边框」都压到最薄，
        把垂直空间几乎全部让给图片本身。
    -->
    <Grid x:Name="Root" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部：极简，只有「这是哪一张」 ============ -->
        <Grid x:Name="ToolbarHeader" Grid.Row="0" Padding="28,20,24,0"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="灯箱" Style="{StaticResource AppEyebrowStyle}" />
                <TextBlock x:Name="MetaText" Style="{StaticResource AppHintTextStyle}"
                           TextWrapping="NoWrap" MaxWidth="560"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Bottom" Margin="0,0,0,1">
                <HyperlinkButton x:Name="SourceLinkButton" Content="打开来源"
                                 FontSize="12.5" Visibility="Collapsed" Click="OnOpenSource" />
                <HyperlinkButton x:Name="SaucenaoButton" Content="SauceNAO 反搜"
                                 FontSize="12.5" Visibility="Collapsed" Click="OnOpenSaucenao"
                                 ToolTipService.ToolTip="以图搜图：在 SauceNAO 查找这张图的来源" />
                <HyperlinkButton x:Name="IqdbButton" Content="IQDB 反搜"
                                 FontSize="12.5" Visibility="Collapsed" Click="OnOpenIqdb"
                                 ToolTipService.ToolTip="以图搜图：在 IQDB 查找缩略图与更高清版本" />
                <Button x:Name="CopyLinkButton" Style="{StaticResource AppIconButtonStyle}"
                        Visibility="Collapsed" Click="OnCopyImageLink"
                        ToolTipService.ToolTip="复制图片直链">
                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 标签条：夹在两道细线之间，点一下即切到该标签的画廊 ============ -->
        <Border x:Name="TagsHost" Grid.Row="1"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="0,1,0,1"
                Margin="0,18,0,0" Padding="24,9"
                Visibility="Collapsed">
            <StackPanel Spacing="6">
                <TextBlock Text="标签（点击浏览该标签下的图片）"
                           Style="{StaticResource AppGroupHeaderStyle}" />
                <ItemsControl x:Name="TagsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:SimpleWrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============ 灯箱台面 ============ -->
        <Grid x:Name="ViewArea" Grid.Row="2" Margin="20,16,20,14"
              Background="{ThemeResource AppViewerBackgroundBrush}"
              BorderBrush="{ThemeResource AppHairlineBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource PanelCornerRadius}"
              DoubleTapped="OnViewAreaDoubleTapped">
            <ScrollViewer x:Name="ViewScroller"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.25"
                          MaxZoomFactor="4"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Enabled">
                <Image x:Name="ViewImage" Stretch="Uniform" />
            </ScrollViewer>

            <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="False"
                          Foreground="{ThemeResource AppAccentBrush}" />

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE7BA;" FontSize="30"
                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                <TextBlock x:Name="ErrorText" Text="加载失败"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                <Button x:Name="RetryButton" Content="重试" Click="OnRetry"
                        Style="{StaticResource AppPillButtonStyle}" />
            </StackPanel>

            <!-- 图片信息（左下）：等宽读数，深色玻璃底 -->
            <StackPanel x:Name="InfoChips" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="14,0,0,14" Visibility="Collapsed">
                <Border x:Name="ArtistChip" CornerRadius="5" Background="#B3070809" Padding="8,3">
                    <TextBlock x:Name="ArtistText"
                               FontFamily="{StaticResource AppFontMono}" FontSize="10.5"
                               CharacterSpacing="50" Foreground="#FFEDEFF2" />
                </Border>
                <Border x:Name="ResChip" CornerRadius="5" Background="#B3070809" Padding="8,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ResText"
                               FontFamily="{StaticResource AppFontMono}" FontSize="10.5"
                               CharacterSpacing="30" Foreground="#FFEDEFF2" />
                </Border>
            </StackPanel>

            <!-- 浮动工具栏：底部居中的一片玻璃，圆角取满，像一块压在照片上的镇纸 -->
            <Border x:Name="FloatingToolbar" Style="{StaticResource AppFloatingToolbarStyle}"
                    CornerRadius="999" Padding="7,6"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button x:Name="RefreshButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnRefresh" ToolTipService.ToolTip="换一张（空格）">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnSave" ToolTipService.ToolTip="保存（Ctrl+S）">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="18" Margin="7,0" VerticalAlignment="Center"
                            Background="{ThemeResource AppHairlineStrongBrush}" />
                    <Button x:Name="ZoomOutButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnZoomOut" ToolTipService.ToolTip="缩小（Ctrl+-）">
                        <!--
                            原来是 &#xE8A2; —— 官方名是 AttachCamera，画出来是**一台相机**。
                            码位存在、渲染得出来，所以「字形有没有」这类检查全绿，
                            只有把字形画出来才看得出不对。现改用 E71F ZoomOut，与放大 E8A3 成对。
                            avalonia 分支已同步修正。
                        -->
                        <FontIcon Glyph="&#xE71F;" FontSize="14" />
                    </Button>
                    <Border MinWidth="50" Padding="4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomLabel" Text="100%"
                                   Style="{StaticResource AppMonoStrongStyle}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Button x:Name="ZoomInButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnZoomIn" ToolTipService.ToolTip="放大（Ctrl++）">
                        <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="18" Margin="7,0" VerticalAlignment="Center"
                            Background="{ThemeResource AppHairlineStrongBrush}" />
                    <Button x:Name="FitButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnFitToScreen" ToolTipService.ToolTip="适应屏幕（Ctrl+0）">
                        <!-- 原来是 &#xE7C3;（官方名 Page，画的是一张文档）。改用 E9A6 FitPage。 -->
                        <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                    </Button>
                    <Button x:Name="ActualSizeButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnActualSize" ToolTipService.ToolTip="实际大小">
                        <!--
                            原来用 &#xE738;，但它的官方名是 Remove —— 画出来就是**一根短横线**，
                            与「实际大小」毫无关系。Segoe 里没有「1:1 / ActualSize」的字形
                            （E71E Zoom 是放大镜加号，会与放大重复），所以这里写等宽数字：
                            与同排的 100% 读数同族，语义零歧义，也符合「所有数字走等宽」。
                        -->
                        <TextBlock Text="1:1" FontFamily="{StaticResource AppFontMono}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="StretchButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnStretchFill" ToolTipService.ToolTip="拉伸填充">
                        <!--
                            原来是 &#xE78F;，但该码位在 Segoe Fluent Icons 与 Segoe MDL2 Assets 里
                            都不存在（E78D/E78E/E78F 是空档，E78C 与 E790 才有字形），
                            所以这个按钮一直是空白的。改用 E799 AspectRatio（改宽高比铺满）。
                            avalonia 分支已同步修正。
                        -->
                        <FontIcon Glyph="&#xE799;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="18" Margin="7,0" VerticalAlignment="Center"
                            Background="{ThemeResource AppHairlineStrongBrush}" />
                    <Button x:Name="FullscreenButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnToggleFullscreen" ToolTipService.ToolTip="全屏（F11）">
                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 页脚轨道 ============ -->
        <Border x:Name="StatusBar" Grid.Row="3" Style="{StaticResource AppStatusBarStyle}"
                Height="42" Padding="24,0,24,0">
            <Grid ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="6" Height="6"
                         Style="{StaticResource AppStatusDotOkStyle}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪"
                           Style="{StaticResource AppCaptionTextStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
