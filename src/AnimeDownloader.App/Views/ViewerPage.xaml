<Page
    x:Class="AnimeDownloader.App.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <StackPanel x:Name="Toolbar" Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshButton" Content="换一张" Click="OnRefresh" />
            <Button x:Name="SaveButton" Content="保存" Click="OnSave" />
            <Button x:Name="FullscreenButton" Content="全屏" Click="OnToggleFullscreen" />
            <TextBlock x:Name="MetaText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </StackPanel>

        <!-- 大图：默认完整显示（Uniform 等比缩放到可视区域） -->
        <Grid x:Name="ViewArea" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="8">
            <Image x:Name="ViewImage" Stretch="Uniform" />
            <ProgressRing x:Name="LoadingRing" Width="48" Height="48" IsActive="False" />
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ErrorText" Text="加载失败" />
                <Button x:Name="RetryButton" Content="重试" Click="OnRetry" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪" />
    </Grid>
</Page>
