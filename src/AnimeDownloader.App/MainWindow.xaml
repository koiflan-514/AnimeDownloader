<Window
    x:Class="AnimeDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AnimeDownloader">

    <Grid x:Name="Root">
        <NavigationView
            x:Name="RootNav"
            PaneDisplayMode="Left"
            OpenPaneLength="320"
            CompactPaneLength="48"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneOpening="OnPaneOpening"
            PaneClosing="OnPaneClosing"
            SelectionChanged="OnNavigationSelectionChanged"
            Loaded="OnNavigationLoaded">

            <NavigationView.PaneHeader>
                <Grid Padding="8,8,8,12">
                    <StackPanel x:Name="PaneHeaderExpanded" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B9;" FontSize="22"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText" Text="AnimeDownloader"
                                   Style="{StaticResource TitleTextBlockStyle}" FontSize="16"
                                   VerticalAlignment="Center" />
                        <Border x:Name="HeaderThumbBorder" Width="36" Height="36" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Image x:Name="HeaderThumb" Stretch="UniformToFill" />
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PaneHeaderCompact" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B9;" FontSize="24"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GalleryNavItem" Content="画廊" Tag="gallery">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ViewerNavItem" Content="查看器" Tag="viewer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneCustomContent>
                <StackPanel Spacing="10" Padding="0,12,0,0">
                    <TextBlock x:Name="SourceLabel" Text="图源"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        x:Name="SourceCombo"
                        HorizontalAlignment="Stretch"
                        MaxDropDownHeight="360"
                        SelectionChanged="OnSourceSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,4" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="NsfwLabel" Text="NSFW"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="NsfwCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="OnNsfwSelectionChanged">
                        <ComboBoxItem Content="屏蔽 NSFW" Tag="BlockNsfw" />
                        <ComboBoxItem Content="仅 NSFW" Tag="OnlyNsfw" />
                        <ComboBoxItem Content="全部显示" Tag="ShowEverything" />
                    </ComboBox>

                    <Button x:Name="GlobalRefreshButton" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnGlobalRefresh" ToolTipService.ToolTip="刷新当前页面">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.PaneFooter>
                <Border Style="{StaticResource AppStatusBarStyle}" Margin="8,12,8,8">
                    <TextBlock x:Name="GlobalStatusText" Text="就绪"
                               Style="{StaticResource AppCaptionTextStyle}" />
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
