<Window
    x:Class="AnimeDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnimeDownloader.App.Controls"
    Title="AnimeDownloader">

    <!--
        ============================================================================
        外壳：56px 图标导轨 + 常驻命令条
        ============================================================================
        旧结构是一条约 320px 的常开侧栏，既做导航又塞了图源 / 过滤 / 刷新 / 缓存，
        内容区被吃掉四分之一宽度，而「图源」这个每次都要动的控件却藏在侧栏里。
        新结构把它拆成两层：
            导轨   —— 只负责「我在哪」（图标 + 指示条），永不抢宽度。
            命令条 —— 只负责「我在看什么」（图源 / 过滤 / 状态 / 操作），常驻在内容上方。

        导轨为什么是手绘的 Grid 而不是 NavigationView：后者的收起态会把
        PaneCustomContent 整段渲染进 56px 的窄栏里（内容被裁成残句）、把菜单项挤到
        导轨底部，且选中指示条不吃应用层的资源覆盖。三个图标不值得付出这些代价。
    -->
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}" Loaded="OnShellLoaded"
          KeyDown="OnShellKeyDown">
        <!--
            F11 走 KeyboardAccelerator 而不是 KeyDown：加速器是窗口级的，焦点在哪儿都能触发；
            KeyDown 只会在有焦点的元素上冒泡，焦点落在启动时空着的内容区就完全收不到。
            Esc 仍然走 KeyDown —— 它只在冒泡到底时才轮到我们，被 ComboBox / 弹层消化掉的
            Esc 不会被误当成"退出全屏"。
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnFullscreenAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 导轨 ==================== -->
        <Border x:Name="RailHost"
                Grid.Column="0"
                Background="{ThemeResource AppRailBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 三个目的地：顶对齐，各自带图标与提示 -->
                <StackPanel Grid.Row="0" Spacing="2" Padding="0,12,0,0">
                    <RadioButton x:Name="GalleryRailItem" Tag="gallery" GroupName="RailNav"
                                 Style="{StaticResource AppRailItemStyle}"
                                 Checked="OnRailItemChecked"
                                 AutomationProperties.Name="画廊"
                                 ToolTipService.ToolTip="画廊 — 浏览当前图源的图片">
                        <FontIcon Glyph="&#xE91B;" FontSize="17" />
                    </RadioButton>
                    <RadioButton x:Name="ViewerRailItem" Tag="viewer" GroupName="RailNav"
                                 Style="{StaticResource AppRailItemStyle}"
                                 Checked="OnRailItemChecked"
                                 AutomationProperties.Name="灯箱"
                                 ToolTipService.ToolTip="灯箱 — 单图细看（画廊里双击图片也可进入）">
                        <FontIcon Glyph="&#xE740;" FontSize="17" />
                    </RadioButton>
                    <RadioButton x:Name="SettingsRailItem" Tag="settings" GroupName="RailNav"
                                 Style="{StaticResource AppRailItemStyle}"
                                 Checked="OnRailItemChecked"
                                 AutomationProperties.Name="设置"
                                 ToolTipService.ToolTip="设置 — 图源凭据、网络、下载">
                        <FontIcon Glyph="&#xE713;" FontSize="17" />
                    </RadioButton>
                </StackPanel>

                <!--
                    底部：快捷键速查（浮层）+ 应用标记。
                    快捷键表原本住在 NavigationView 的展开面板里，而展开面板在收起态
                    会把内容挤进 56px，因此改挂在一枚按钮的浮层上 —— 信息还在，导轨干净。
                -->
                <StackPanel Grid.Row="2" Padding="0,0,0,14" Spacing="6" HorizontalAlignment="Center">
                    <Button Style="{StaticResource AppIconButtonStyle}"
                            AutomationProperties.Name="快捷键速查"
                            ToolTipService.Placement="Right"
                            ToolTipService.ToolTip="快捷键速查">
                        <FontIcon Glyph="&#xE765;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop">
                                <StackPanel Spacing="12" MinWidth="252">
                                    <TextBlock Text="快捷键" Style="{StaticResource AppGroupHeaderStyle}" />
                                    <Grid ColumnSpacing="18" RowSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="← →" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="上一页 / 下一页" Style="{StaticResource AppHintTextStyle}" />
                                        <TextBlock Grid.Row="1" Text="Space" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="换一张" Style="{StaticResource AppHintTextStyle}" />
                                        <TextBlock Grid.Row="2" Text="Enter" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="打开大图" Style="{StaticResource AppHintTextStyle}" />
                                        <TextBlock Grid.Row="3" Text="Ctrl S" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="保存当前图片" Style="{StaticResource AppHintTextStyle}" />
                                        <TextBlock Grid.Row="4" Text="Ctrl 0" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="适应屏幕" Style="{StaticResource AppHintTextStyle}" />
                                        <TextBlock Grid.Row="5" Text="F11" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="全屏" Style="{StaticResource AppHintTextStyle}" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource AppHairlineBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <TextBlock Text="AnimeDownloader" Style="{StaticResource AppCaptionTextStyle}" />
                                        <TextBlock x:Name="VersionText" Text="" Style="{StaticResource AppCaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Image x:Name="FooterLogo" Width="20" Height="20"
                           Stretch="UniformToFill" Opacity="0.6"
                           ToolTipService.Placement="Right"
                           ToolTipService.ToolTip="AnimeDownloader" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 命令条 + 内容 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                命令条：图源与过滤常驻可见 —— 这是旧版最大的可用性问题
                （每次换图源都要先展开侧栏）。状态与操作落在右端对齐。

                列宽分配是这条栏的关键（窄窗口下会立刻暴露）：
                    图源 / 过滤 / 操作 = Auto —— 它们是「不许被压缩」的控件；
                    状态 = *  —— 空间不够时先由它让位，省略号收尾。
                把过滤放进 * 列（或让状态去挤它）会出现分段器被右端状态压掉一半的
                重叠画面，而且每个列都会各自「尽量满足自己」，看起来完全不讲道理。
            -->
            <Border x:Name="CommandBarHost" Grid.Row="0" Height="50"
                    Background="{ThemeResource AppBackgroundBrush}"
                    BorderBrush="{ThemeResource AppHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0,16,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图源 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="图源" Style="{StaticResource AppLabelStyle}" />
                        <ComboBox x:Name="SourceCombo"
                                  MinWidth="168" MaxWidth="240"
                                  MaxDropDownHeight="420"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="选择图源"
                                  SelectionChanged="OnSourceSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Padding="0,3" MaxWidth="320">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Height="18"
                            Background="{ThemeResource AppHairlineStrongBrush}"
                            VerticalAlignment="Center" />

                    <!-- 过滤：放在 Auto 列，永不压缩 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="过滤" Style="{StaticResource AppLabelStyle}" />
                        <controls:SegmentedControl x:Name="NsfwSegmented"
                                                   MinWidth="196"
                                                   VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="NSFW 过滤"
                                                   SelectionChanged="OnNsfwSelectionChanged" />
                    </StackPanel>

                    <!-- 缩略图 + 状态：星号列，空间不足时缩成省略号 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="HeaderThumbBorder" Width="26" Height="26" CornerRadius="6"
                                Background="{ThemeResource AppCardFillBrush}"
                                BorderBrush="{ThemeResource AppHairlineStrongBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Image x:Name="HeaderThumb" Stretch="UniformToFill" />
                        </Border>

                        <!-- 用 Grid 而不是 StackPanel：只有星号列里的文本才会真的收缩，
                             横向 StackPanel 会给文本它的完整期望宽度然后被裁掉右边。 -->
                        <Grid ColumnSpacing="6" MaxWidth="230" Margin="4,0,4,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                     Style="{StaticResource AppStatusDotOkStyle}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="GlobalStatusText" Grid.Column="1" Text="就绪"
                                       Style="{StaticResource AppCaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>

                    <!-- 操作 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button x:Name="GlobalRefreshButton" Style="{StaticResource AppPillButtonStyle}"
                                Click="OnGlobalRefresh" ToolTipService.ToolTip="重新加载当前页面">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock x:Name="RefreshButtonText" Text="刷新" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearCacheButton" Style="{StaticResource AppIconButtonStyle}"
                                Click="OnClearCacheClick" ToolTipService.ToolTip="清理缩略图缓存">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
