<Window
    x:Class="AnimeDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AnimeDownloader">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 全局工具栏：两种模式（查看器/画廊）共享的图源、NSFW 过滤与刷新 -->
        <Grid Grid.Row="0" Padding="24,10,24,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="图源" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    x:Name="SourceCombo"
                    MinWidth="240"
                    MaxDropDownHeight="360"
                    SelectionChanged="OnSourceSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,4" Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="NSFW" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="NsfwCombo" MinWidth="130" SelectionChanged="OnNsfwSelectionChanged">
                    <ComboBoxItem Content="屏蔽 NSFW" Tag="BlockNsfw" />
                    <ComboBoxItem Content="仅 NSFW" Tag="OnlyNsfw" />
                    <ComboBoxItem Content="全部显示" Tag="ShowEverything" />
                </ComboBox>
            </StackPanel>

            <Button Grid.Column="3" x:Name="GlobalRefreshButton" Content="刷新"
                    VerticalAlignment="Center" Click="OnGlobalRefresh" />

            <TextBlock Grid.Column="4" x:Name="GlobalStatusText"
                       Text="就绪" VerticalAlignment="Center" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="RootNav"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged"
            Loaded="OnNavigationLoaded">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GalleryNavItem" Content="画廊" Tag="gallery">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ViewerNavItem" Content="查看器" Tag="viewer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
