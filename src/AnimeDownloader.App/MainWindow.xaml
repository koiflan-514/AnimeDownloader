<Window
    x:Class="AnimeDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnimeDownloader.App.Controls"
    Title="AnimeDownloader">

    <Grid x:Name="Root">
        <NavigationView
            x:Name="RootNav"
            PaneDisplayMode="Left"
            OpenPaneLength="320"
            CompactPaneLength="56"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneOpening="OnPaneOpening"
            PaneClosing="OnPaneClosing"
            SelectionChanged="OnNavigationSelectionChanged"
            Loaded="OnNavigationLoaded">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,10,12,14">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{ThemeResource AppAccentGradientBrush}"
                            VerticalAlignment="Center">
                        <Image x:Name="HeaderLogo" Width="20" Height="20" Stretch="UniformToFill"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock x:Name="TitleText" Text="AnimeDownloader" FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="VersionText" Text="" FontSize="10.5"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    </StackPanel>
                    <Border x:Name="HeaderThumbBorder" Width="36" Height="36" CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Image x:Name="HeaderThumb" Stretch="UniformToFill" />
                    </Border>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GalleryNavItem" Content="画廊" Tag="gallery">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ViewerNavItem" Content="查看器" Tag="viewer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE740;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneCustomContent>
                <StackPanel x:Name="PaneControls" Spacing="12" Padding="16,8,16,0">
                    <TextBlock Text="图源"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Margin="4,0,0,0" />
                    <ComboBox
                        x:Name="SourceCombo"
                        HorizontalAlignment="Stretch"
                        MaxDropDownHeight="400"
                        ToolTipService.ToolTip="选择图源"
                        SelectionChanged="OnSourceSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1" Padding="0,4">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                <TextBlock Text="{Binding Description}" FontSize="11"
                                           Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="NSFW"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Margin="4,0,0,0" />
                    <controls:SegmentedControl x:Name="NsfwSegmented"
                                               HorizontalAlignment="Stretch"
                                               ToolTipService.ToolTip="NSFW 过滤"
                                               SelectionChanged="OnNsfwSelectionChanged" />

                    <Button x:Name="GlobalRefreshButton" HorizontalAlignment="Stretch"
                            Style="{StaticResource AppAccentButtonStyle}"
                            Click="OnGlobalRefresh" ToolTipService.ToolTip="刷新当前页面">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="RefreshButtonText" Text="刷新" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearCacheButton" HorizontalAlignment="Stretch"
                            Style="{StaticResource AppPillButtonStyle}"
                            Click="OnClearCacheClick" ToolTipService.ToolTip="清除缩略图缓存">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="ClearCacheButtonText" Text="清理缓存" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.PaneFooter>
                <Grid>
                    <Border x:Name="PaneFooterExpanded" Style="{StaticResource AppStatusBarStyle}"
                            Margin="12,12,12,8" Padding="12,8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Style="{StaticResource AppStatusDotOkStyle}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="GlobalStatusText" Grid.Column="1" Text="就绪"
                                       Style="{StaticResource AppCaptionTextStyle}" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="PaneFooterCompact" Visibility="Collapsed"
                                Margin="0,12,0,12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="FooterLogo" Width="36" Height="36" Stretch="UniformToFill" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
