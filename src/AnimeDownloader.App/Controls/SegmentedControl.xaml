<UserControl
    x:Class="AnimeDownloader.App.Controls.SegmentedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Shell"
            Background="{ThemeResource AppTagChipBrush}"
            BorderBrush="{ThemeResource AppCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="4">
        <!-- Grid 星号列：整个区域宽度均分给每项（等宽），栏间零空隙 -->
        <Grid x:Name="ItemsHost" />
    </Border>
</UserControl>