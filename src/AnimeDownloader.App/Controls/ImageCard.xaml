<UserControl
    x:Class="AnimeDownloader.App.Controls.ImageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    IsTabStop="True"
    AutomationProperties.Name="图片卡片">

    <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border Style="{StaticResource AppCardBorderStyle}">
            <Grid>
                <Image x:Name="Thumb" Stretch="UniformToFill" />
                <Border x:Name="ArtistOverlay"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        Opacity="0.88"
                        Visibility="Collapsed"
                        Padding="8,4">
                    <TextBlock x:Name="ArtistText"
                               Style="{StaticResource AppCaptionTextStyle}"
                               FontSize="11"
                               TextAlignment="Center"
                               MaxLines="1" />
                </Border>
            </Grid>
        </Border>

        <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="True" />

        <Border x:Name="ErrorOverlay"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <FontIcon Glyph="&#xE7BA;" FontSize="24"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Text="加载失败" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
