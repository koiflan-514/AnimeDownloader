<Window
    x:Class="AnimeDownloader.App.Controls.GalleryViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnimeDownloader.App.Controls"
    Title="图片查看器">

    <!--
        独立大图窗口：与「灯箱」同一套语言 —— 台面压到最深，控件退成玻璃。
    -->
    <Grid x:Name="Root" KeyDown="OnWindowKeyDown"
          Background="{ThemeResource AppViewerBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ViewHost" Grid.Row="0">
            <Image x:Name="ViewImage" Stretch="Uniform" />
            <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="False"
                          Foreground="{ThemeResource AppAccentBrush}" />
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                <TextBlock x:Name="ErrorText" Text="加载失败"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 底部：标签条（图片下方独立一栏，全屏时隐藏）+ 浮动工具栏 -->
        <StackPanel Grid.Row="1" Spacing="10" Padding="0,0,0,14">
            <Border x:Name="TagsHost"
                    Margin="20,0,20,0" MaxHeight="140"
                    Background="{ThemeResource AppToolbarFillBrush}"
                    BorderBrush="{ThemeResource AppHairlineStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    Padding="14,11" Visibility="Collapsed"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="7">
                    <TextBlock Text="标签（点击浏览该标签下的图片）"
                               Style="{StaticResource AppGroupHeaderStyle}" />
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TagsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SimpleWrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border x:Name="Toolbar" Style="{StaticResource AppFloatingToolbarStyle}"
                    CornerRadius="999" Padding="7,6"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button x:Name="PrevButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnPrev" ToolTipService.ToolTip="上一张（←）">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                    </Button>
                    <Border MinWidth="66" VerticalAlignment="Center">
                        <TextBlock x:Name="IndexLabel" Text="1 / 1"
                                   Style="{StaticResource AppMonoStrongStyle}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Button x:Name="NextButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnNext" ToolTipService.ToolTip="下一张（→）">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="18" Margin="7,0" VerticalAlignment="Center"
                            Background="{ThemeResource AppHairlineStrongBrush}" />
                    <Border x:Name="WindowThumbBorder" Width="32" Height="32" CornerRadius="7"
                            Background="{ThemeResource AppSurfaceSunkenBrush}"
                            BorderBrush="{ThemeResource AppHairlineStrongBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,4,0"
                            Visibility="Collapsed">
                        <Image x:Name="WindowThumb" Stretch="UniformToFill" />
                    </Border>
                    <Button x:Name="SaveButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnSave" ToolTipService.ToolTip="保存">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="18" Margin="7,0" VerticalAlignment="Center"
                            Background="{ThemeResource AppHairlineStrongBrush}" />
                    <Button x:Name="FullscreenButton" Style="{StaticResource AppIconButtonStyle}"
                            Click="OnToggleFullscreen" ToolTipService.ToolTip="全屏（F11）">
                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
