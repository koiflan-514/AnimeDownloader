<Application
    x:Class="AnimeDownloader.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                强调色完全跟随用户自己的 Windows 个性化配色：
                不再覆盖 SystemAccentColor*（那会遮蔽系统值），所有 AppAccent* 笔刷
                通过 ThemeResource 引用框架的系统强调色，由 WindowsColorScheme 服务
                监听 UISettings.ColorValuesChanged 实现运行中实时刷新。
            -->

            <!-- 应用级设计令牌：亮 / 暗两套主题资源（中性表面 + 系统强调色） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF121216" />
                    <SolidColorBrush x:Key="AppPanelFillBrush" Color="#F21A1A20" />
                    <SolidColorBrush x:Key="AppCardFillBrush" Color="#FF1F1F26" />
                    <SolidColorBrush x:Key="AppCardFillHoverBrush" Color="#FF26262E" />
                    <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFF4F4F6" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#C2F4F4F6" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#8FF4F4F6" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppAccentBrush2" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush"
                                     Color="{ThemeResource SystemAccentColor}"
                                     Opacity="0.15" />
                    <!-- 与 Fluent 一致：强调操作使用纯色强调色，不做渐变 -->
                    <SolidColorBrush x:Key="AppAccentGradientBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppStatusOkBrush" Color="#FF35C075" />
                    <SolidColorBrush x:Key="AppStatusBusyBrush" Color="#FFE8A23D" />
                    <SolidColorBrush x:Key="AppStatusErrorBrush" Color="#FFE5484D" />
                    <SolidColorBrush x:Key="AppToolbarFillBrush" Color="#F21A1A20" />
                    <SolidColorBrush x:Key="AppTagChipBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="AppViewerBackgroundBrush" Color="#FF08080A" />
                    <LinearGradientBrush x:Key="AppScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF6F6F9" />
                    <SolidColorBrush x:Key="AppPanelFillBrush" Color="#EBEEEEF3" />
                    <SolidColorBrush x:Key="AppCardFillBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppCardFillHoverBrush" Color="#FFFAFAFD" />
                    <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF1C1C22" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#991C1C22" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#661C1C22" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="AppAccentBrush2" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush"
                                     Color="{ThemeResource SystemAccentColor}"
                                     Opacity="0.09" />
                    <SolidColorBrush x:Key="AppAccentGradientBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="AppStatusOkBrush" Color="#FF1E9E58" />
                    <SolidColorBrush x:Key="AppStatusBusyBrush" Color="#FFB97417" />
                    <SolidColorBrush x:Key="AppStatusErrorBrush" Color="#FFD13B40" />
                    <SolidColorBrush x:Key="AppToolbarFillBrush" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="AppTagChipBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="AppViewerBackgroundBrush" Color="#FF0C0C0E" />
                    <LinearGradientBrush x:Key="AppScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#66000000" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
