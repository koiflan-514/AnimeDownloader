<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Prevent stale machine-level SDK fallback paths from breaking restore/build. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
