<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ============================================================================
    依赖源：国内镜像优先
    ============================================================================
    国内直连 nuget.org 常常只有几十 KB/s，而 `dotnet workload install android` 要拉
    十几个包（Android SDK / Runtime / MonoAOTCompiler…），走官方源实测 3 分钟以上
    且容易被网络掐断。这里把两家中立镜像排在前面，nuget.org 退到最后一位只作兜底 ——
    NuGet 按顺序命中，镜像里有就不会再去外网。

      1. 华为云  —— v3 协议（Artifactory 代理）。**已实测携带 workload 包**：
                    `microsoft.net.sdk.android.manifest-10.0.100` 与
                    `microsoft.android.sdk.windows` 都能取到，所以工作负载安装也走它。
      2. 腾讯云  —— v2 协议，作为华为云不可用时的备份。
      3. nuget.org —— 兜底。镜像没同步到的包（长尾、刚发布的新包）仍然能装上。

    安装工作负载要用命令行显式指定同一组源 —— `dotnet workload install` 不读本文件
    （注意：本文件是 XML，注释里不能出现两个连续连字符，所以下面用短选项 `-s`）：

        dotnet workload install android ^
          -s https://mirrors.huaweicloud.com/repository/nuget/v3/index.json ^
          -s https://api.nuget.org/v3/index.json
  -->
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
    <add key="tencent" value="https://mirrors.cloud.tencent.com/nuget/" protocolVersion="2" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Prevent stale machine-level SDK fallback paths from breaking restore/build. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
