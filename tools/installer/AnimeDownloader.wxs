<?xml version="1.0" encoding="UTF-8"?>
<!--
AnimeDownloader — WiX v4/v7 安装程序定义。

打包脚本（publish-self-contained.ps1 / publish-framework-dependent.ps1）
通过预处理变量注入：
  $(var.PublishDir)  应用发布目录（含全部输出文件，绝对路径）
  $(var.Version)     版本号（如 0.1.0）

功能树（WixUI_FeatureTree 提供安装目录选择 + 可选功能）：
  MainApp            主程序（必选）
  DesktopShortcut    桌面快捷方式（可选，默认安装）
  StartMenuShortcut  开始菜单快捷方式（可选，默认安装）
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="AnimeDownloader"
      Manufacturer="AnimeDownloader contributors"
      Version="$(var.Version)"
      UpgradeCode="0E51E45D-1D6F-4F6A-9B1A-7C2E8D4A5B6C"
      Scope="perMachine"
      Codepage="65001">

    <SummaryInformation
        Description="Anime image browser and downloader (WinUI 3)"
        Manufacturer="AnimeDownloader contributors" />

    <!-- 在“程序和功能”中显示应用图标 -->
    <Icon Id="AppIcon" SourceFile="..\..\src\icons\AnimeDownloader.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- 同版本/更高版本安装时提示降级（保留用户数据） -->
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 [ProductName]，无法继续安装。" />

    <!-- 压缩级别：high 减小 msi 体积 -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 目录结构 -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AnimeDownloader" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="AnimeDownloader" />
    </StandardDirectory>

    <!-- 主程序文件：ComponentGroup 顶层定义，经 DirectoryRef 落到 INSTALLFOLDER -->
    <ComponentGroup Id="AppFilesGroup" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**\*" />
    </ComponentGroup>

    <!-- 卸载时移除安装目录（若为空） -->
    <ComponentGroup Id="CleanupGroup" Directory="INSTALLFOLDER">
      <Component Id="RemoveInstallFolder" Guid="*">
        <RemoveFolder Id="RemoveInstallFolderDir" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\AnimeDownloader"
            Name="InstallFolder"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 桌面快捷方式（可选功能） -->
    <ComponentGroup Id="DesktopShortcutGroup" Directory="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut
            Id="DesktopShortcut"
            Name="AnimeDownloader"
            Description="Anime image browser and downloader"
            Target="[INSTALLFOLDER]AnimeDownloader.App.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AnimeDownloader"
            Name="DesktopShortcutInstalled"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 开始菜单快捷方式（可选功能） -->
    <ComponentGroup Id="StartMenuShortcutGroup" Directory="StartMenuDir">
      <Component Id="StartMenuShortcutComponent" Guid="*">
        <Shortcut
            Id="StartMenuShortcut"
            Name="AnimeDownloader"
            Description="Anime image browser and downloader"
            Target="[INSTALLFOLDER]AnimeDownloader.App.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AnimeDownloader"
            Name="StartMenuShortcutInstalled"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- 功能树：主程序必选，两个快捷方式可选（默认选中） -->
    <Feature Id="MainApp" Title="AnimeDownloader 主程序" Description="AnimeDownloader 应用程序文件" Level="1">
      <ComponentGroupRef Id="AppFilesGroup" />
      <ComponentGroupRef Id="CleanupGroup" />
    </Feature>

    <Feature Id="DesktopShortcut" Title="桌面快捷方式" Description="在桌面创建 AnimeDownloader 快捷方式" Level="1">
      <ComponentGroupRef Id="DesktopShortcutGroup" />
    </Feature>

    <Feature Id="StartMenuShortcut" Title="开始菜单快捷方式" Description="在开始菜单创建 AnimeDownloader 快捷方式" Level="1">
      <ComponentGroupRef Id="StartMenuShortcutGroup" />
    </Feature>

    <!-- 标准 UI：安装目录选择 + 功能树（可勾选快捷方式） -->
    <!-- 面向普通用户的安装向导：欢迎 -> 许可协议 -> 目标文件夹（可更改）-> 准备就绪 -> 完成（含卸载指引） -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- 允许从命令行设置 INSTALLFOLDER 与 ADDLOCAL -->
  </Package>

</Wix>
